POSTGRES_USER=peludos_user
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=peludos_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://peludos_user:cambia_esta_clave@db:5432/peludos_db

# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Puerto de la API en tu máquina (en Windows el 8000 a veces está reservado: usa 8001)
API_PORT=8000

# Orígenes del frontend separados por coma, ej: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=
